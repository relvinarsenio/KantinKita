<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="KantinKita.Views.Tabs.ProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KantinKita.Controls"
    xmlns:motion="clr-namespace:KantinKita.Helpers"
    xmlns:vm="clr-namespace:KantinKita.ViewModels"
    x:DataType="vm:ProfileViewModel">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout x:Name="ScrollBody" Padding="22,22,22,28" Spacing="22">
            <Grid motion:UiMotion.Reveal="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="5">
                    <Label Text="AKUN KAMPUS" Style="{StaticResource TxtOverline}" FontSize="10" />
                    <Label Text="Profil" Style="{StaticResource TxtH1}" FontSize="30" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Style="{StaticResource CircleIconBorder}" StrokeShape="RoundRectangle 12" VerticalOptions="Center" SemanticProperties.Description="Ubah profil">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding EditProfileCommand}" /></Border.GestureRecognizers>
                    <controls:Icon Glyph="{x:Static controls:Icons.Edit}" Size="18" Style="{StaticResource IconBase}" />
                </Border>
            </Grid>

            <Border motion:UiMotion.Reveal="45" Style="{StaticResource Card}" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}">
                            <Label Text="{Binding Initials}" FontFamily="sans-serif-medium" FontSize="20" TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding Name}" Style="{StaticResource TxtH3}" FontSize="18" LineBreakMode="WordWrap" />
                            <Label Text="{Binding Program}" Style="{StaticResource TxtCaption}" FontSize="11.5" />
                            <Label Text="{Binding Nim}" Style="{StaticResource TxtCaption}" FontSize="10.5" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <controls:Icon Glyph="{x:Static controls:Icons.Pin}" Size="14" Style="{StaticResource IconMuted}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Campus}" Style="{StaticResource TxtCaption}" FontSize="11.5" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 18" BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="SALDO KANTIN" Style="{StaticResource TxtOverline}" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" VerticalOptions="Center" />
                        <controls:Icon Grid.Column="1" Glyph="{x:Static controls:Icons.Wallet}" Size="19" Style="{StaticResource IconBrand}" />
                    </Grid>
                    <Grid motion:UiMotion.Reveal="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="{Binding BalanceText}" Style="{StaticResource TxtH1}" FontSize="27" />
                            <Label Text="Siap untuk pesanan berikutnya." Style="{StaticResource TxtCaption}" FontSize="10.5" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Top up" Command="{Binding TopUpCommand}" Style="{StaticResource BtnPrimary}" FontSize="12" HeightRequest="42" Padding="14,0" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Panel}" Padding="16" StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="*,1,*,1,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding OrderCountText}" Style="{StaticResource TxtH2}" FontSize="23" />
                        <Label Text="Pesanan" Style="{StaticResource TxtCaption}" FontSize="10.5" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="1" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="{Binding FavoriteCountText}" Style="{StaticResource TxtH2}" FontSize="23" />
                        <Label Text="Favorit" Style="{StaticResource TxtCaption}" FontSize="10.5" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="3" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                    <VerticalStackLayout Grid.Column="4" Spacing="4">
                        <Label Text="{Binding PointsText}" Style="{StaticResource TxtH2}" FontSize="23" />
                        <Label Text="Poin" Style="{StaticResource TxtCaption}" FontSize="10.5" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="11">
                <Label Text="PENGATURAN AKUN" Style="{StaticResource TxtOverline}" FontSize="10" />
                <Border Style="{StaticResource Panel}" Padding="0" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13" ColumnSpacing="12">
                            <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                                <controls:Icon Glyph="{x:Static controls:Icons.User}" Size="16" Style="{StaticResource IconMuted}" />
                            </Border>
                            <Label Grid.Column="1" Text="Informasi pribadi" Style="{StaticResource TxtBodyStrong}" FontSize="13" VerticalOptions="Center" />
                            <controls:Icon Grid.Column="2" Glyph="{x:Static controls:Icons.ChevronRight}" Size="15" Style="{StaticResource IconMuted}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding EditProfileCommand}" /></Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Margin="58,0,14,0" Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13" ColumnSpacing="12">
                            <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                                <controls:Icon Glyph="{x:Static controls:Icons.Receipt}" Size="16" Style="{StaticResource IconMuted}" />
                            </Border>
                            <Label Grid.Column="1" Text="Riwayat pesanan" Style="{StaticResource TxtBodyStrong}" FontSize="13" VerticalOptions="Center" />
                            <controls:Icon Grid.Column="2" Glyph="{x:Static controls:Icons.ChevronRight}" Size="15" Style="{StaticResource IconMuted}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenOrdersCommand}" /></Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Margin="58,0,14,0" Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13" ColumnSpacing="12">
                            <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                                <controls:Icon Glyph="{x:Static controls:Icons.Ticket}" Size="16" Style="{StaticResource IconMuted}" />
                            </Border>
                            <Label Grid.Column="1" Text="Voucher saya" Style="{StaticResource TxtBodyStrong}" FontSize="13" VerticalOptions="Center" />
                            <controls:Icon Grid.Column="2" Glyph="{x:Static controls:Icons.ChevronRight}" Size="15" Style="{StaticResource IconMuted}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowVouchersCommand}" /></Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Margin="58,0,14,0" Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13" ColumnSpacing="12">
                            <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                                <controls:Icon Glyph="{x:Static controls:Icons.Help}" Size="16" Style="{StaticResource IconMuted}" />
                            </Border>
                            <Label Grid.Column="1" Text="Pusat bantuan" Style="{StaticResource TxtBodyStrong}" FontSize="13" VerticalOptions="Center" />
                            <controls:Icon Grid.Column="2" Glyph="{x:Static controls:Icons.ChevronRight}" Size="15" Style="{StaticResource IconMuted}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowHelpCommand}" /></Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Border Style="{StaticResource Panel}" Padding="14,12" StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                        <controls:Icon Glyph="{x:Static controls:Icons.Moon}" Size="16" Style="{StaticResource IconMuted}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="Mode AMOLED" Style="{StaticResource TxtBodyStrong}" FontSize="13" />
                        <Label Text="Hitam pekat, nyaman di layar OLED" Style="{StaticResource TxtCaption}" FontSize="10.5" />
                    </VerticalStackLayout>
                    <controls:FluentToggle Grid.Column="2" IsToggled="{Binding IsDarkMode}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Tentang aplikasi" Command="{Binding ShowAboutCommand}" Style="{StaticResource BtnGhost}" FontSize="11.5" HeightRequest="40" />
                    <Button Grid.Column="1" Text="Keluar akun" Command="{Binding SignOutCommand}" Style="{StaticResource BtnGhost}" TextColor="{AppThemeBinding Light={StaticResource Chili600}, Dark={StaticResource Chili500}}" FontSize="11.5" HeightRequest="40" />
                </Grid>
                <Label Text="{Binding VersionText}" Style="{StaticResource TxtCaption}" FontSize="10" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
