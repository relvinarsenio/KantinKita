<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="KantinKita.Views.Tabs.OrdersView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KantinKita.Controls"
    xmlns:motion="clr-namespace:KantinKita.Helpers"
    xmlns:vm="clr-namespace:KantinKita.ViewModels"
    x:DataType="vm:OrdersViewModel">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout x:Name="ScrollBody" Padding="20,20,20,28" Spacing="24">
            <Grid motion:UiMotion.Reveal="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Aktivitas kantin" Style="{StaticResource TxtCaption}" FontSize="12" />
                    <Label Text="Pesanan" Style="{StaticResource TxtH1}" FontSize="24" />
                    <Label Text="{Binding ActiveSummary}" Style="{StaticResource TxtCaption}" FontSize="12" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Style="{StaticResource CircleIconBorder}" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                    <controls:Icon Glyph="{x:Static controls:Icons.Receipt}" Size="19" Style="{StaticResource IconBrand}" />
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding HasActive}">
                <Label Text="Sedang diproses" Style="{StaticResource TxtBodyStrong}" FontSize="14" />
                <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Active}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrderCardViewModel">
                            <Border Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 18">
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Margin="0,16" Color="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                                    <VerticalStackLayout Grid.Column="1" Padding="16" Spacing="16">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding Code}" Style="{StaticResource TxtBodyStrong}" FontSize="14" LineBreakMode="WordWrap" />
                                            <Border Padding="8,4" HorizontalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}">
                                                <Label Text="{Binding StatusText}" FontFamily="sans-serif-medium" FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                                            </Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding ItemsSummary}" Style="{StaticResource TxtBodyStrong}" FontSize="14" MaxLines="2" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding StatusHint}" Style="{StaticResource TxtCaption}" FontSize="12" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                        <FlexLayout BindableLayout.ItemsSource="{Binding Steps}" Direction="Row" Wrap="NoWrap" IsVisible="{Binding ShowSteps}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OrderStepViewModel">
                                                    <VerticalStackLayout FlexLayout.Basis="25%" FlexLayout.Shrink="1" Padding="0,0,4,0" Spacing="8">
                                                        <Border HeightRequest="3" StrokeThickness="0" StrokeShape="RoundRectangle 1" BackgroundColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}">
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                        </Border>
                                                        <Label Text="{Binding Label}" FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontFamily" Value="sans-serif-medium" />
                                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                        <BoxView Style="{StaticResource Divider}" />
                                        <!-- Fulfillment can contain a long building/room name. Keep it out of
                                             the amount's row and constrain the wrapping label with a Grid. -->
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                                <controls:Icon Glyph="{x:Static controls:Icons.Clock}" Size="16" Style="{StaticResource IconMuted}" VerticalOptions="Start" Margin="0,2,0,0" />
                                                <Label Grid.Column="1" Text="{Binding PickupText}" Style="{StaticResource TxtBodyStrong}" FontSize="14" LineBreakMode="WordWrap" />
                                            </Grid>
                                            <Label Text="{Binding PaymentText}" Style="{StaticResource TxtCaption}" FontSize="12" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                        <Border Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="Total pembayaran" Style="{StaticResource TxtCaption}" FontSize="12" />
                                                <Label Text="{Binding TotalText}" motion:UiMotion.Pulse="{Binding TotalText}" Style="{StaticResource TxtH3}" FontSize="20" LineBreakMode="CharacterWrap" />
                                                <Label Text="{Binding ItemCountText}" Style="{StaticResource TxtCaption}" FontSize="12" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Button Text="Lihat struk" Command="{Binding ReceiptCommand}" Style="{StaticResource BtnSecondary}" HeightRequest="48" FontSize="14" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding HasHistory}">
                <Label Text="Riwayat pesanan" Style="{StaticResource TxtBodyStrong}" FontSize="14" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding History}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrderCardViewModel">
                            <Border Style="{StaticResource Card}" Padding="16" StrokeShape="RoundRectangle 16">
                                <VerticalStackLayout Spacing="16">
                                    <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                                        <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                                            <controls:Icon Glyph="{Binding IconPreview}" Size="20" Style="{StaticResource IconBrand}" IsFilled="True" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Code}" Style="{StaticResource TxtBodyStrong}" FontSize="14" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding PlacedText}" Style="{StaticResource TxtCaption}" FontSize="12" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding StatusText}" Style="{StaticResource TxtCaption}" FontSize="12" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Label Text="{Binding ItemsSummary}" Style="{StaticResource TxtBodyStrong}" FontSize="14" MaxLines="2" LineBreakMode="WordWrap" />
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Total pembayaran" Style="{StaticResource TxtCaption}" FontSize="12" />
                                        <Label Text="{Binding TotalText}" motion:UiMotion.Pulse="{Binding TotalText}" Style="{StaticResource TxtH3}" FontSize="20" LineBreakMode="CharacterWrap" />
                                        <Label Text="{Binding PaymentText}" Style="{StaticResource TxtCaption}" FontSize="12" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Button Text="Lihat struk" Command="{Binding ReceiptCommand}" Style="{StaticResource BtnSecondary}" HeightRequest="48" FontSize="14" />
                                    <Button Text="Pesan lagi" Command="{Binding ReorderCommand}" IsVisible="{Binding CanReorder}" Style="{StaticResource BtnSecondary}" HeightRequest="48" FontSize="14" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Border Style="{StaticResource Panel}" Padding="18" IsVisible="{Binding HasHistoryError}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding HistoryError}" Style="{StaticResource TxtCaption}" FontSize="12" />
                    <Button Text="Muat ulang riwayat" Command="{Binding RetryHistoryCommand}" Style="{StaticResource BtnSecondary}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Panel}" Padding="26,34" StrokeShape="RoundRectangle 18" IsVisible="{Binding IsEmpty}">
                <VerticalStackLayout Spacing="14">
                    <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 13" BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}" HorizontalOptions="Center">
                        <controls:Icon Glyph="{x:Static controls:Icons.Receipt}" Size="23" Style="{StaticResource IconBrand}" />
                    </Border>
                    <Label Text="Belum ada pesanan" Style="{StaticResource TxtH2}" FontSize="20" HorizontalTextAlignment="Center" />
                    <Label Text="Pesanan yang kamu buat akan tersimpan di sini, lengkap dengan struk yang bisa dibagikan." Style="{StaticResource TxtCaption}" FontSize="12" LineHeight="1.3" HorizontalTextAlignment="Center" />
                    <Button Text="Jelajahi menu" Command="{Binding BrowseCommand}" Style="{StaticResource BtnPrimary}" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
